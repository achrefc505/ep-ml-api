# Source données pour entraînement
# 'csv'  → lit data/training.csv (bootstrap synthétique pour démarrer)
# 'sql'  → lit la table adjudications de EncheresPredict_Raw
DATA_SOURCE=csv
TRAINING_CSV_PATH=data/training.csv

# SQL Server (utilisé seulement si DATA_SOURCE=sql)
DB_SERVER=(localdb)\mssqllocaldb
DB_NAME=EncheresPredict_Raw
DB_TRUSTED=yes

# Stockage des modèles entraînés
MODELS_DIR=src/models/store

# Seuil mini de lignes par tribunal pour un modèle dédié.
# Sinon, fallback sur le modèle global.
MIN_SAMPLES_PER_TRIBUNAL=30

# Hyperparamètres Random Forest (peuvent être overridés via CLI)
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=20
RF_MIN_SAMPLES_LEAF=3
RF_RANDOM_STATE=42

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
