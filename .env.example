# Source des données d'entraînement
# 'csv'    → CSV synthétique uniquement (bootstrap rapide)
# 'sql'    → table dbo.adjudications de EncheresPredict_Raw uniquement
# 'hybrid' → SQL + complète avec synthétique si < 200 lignes réelles (RECOMMANDÉ au démarrage)
DATA_SOURCE=hybrid
TRAINING_CSV_PATH=data/training.csv

# SQL Server LocalDB (utilisé si DATA_SOURCE=sql ou hybrid)
DB_SERVER=(localdb)\mssqllocaldb
DB_NAME=EncheresPredict_Raw
DB_TRUSTED=yes
# Si auth SQL au lieu de Windows :
# DB_USER=sa
# DB_PASSWORD=YourPwd

# Stockage des modèles entraînés
MODELS_DIR=src/models/store

# Seuil mini de lignes par tribunal pour avoir un modèle dédié.
# Avec 20, dès que Paris a 20+ adjudications scrapées, un modèle TJ Paris est créé.
MIN_SAMPLES_PER_TRIBUNAL=20

# Hyperparamètres Random Forest
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=20
RF_MIN_SAMPLES_LEAF=3
RF_RANDOM_STATE=42

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
